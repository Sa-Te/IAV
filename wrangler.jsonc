{
  // Cloudflare Workers static assets for apps/web.
  // The directory is explicit because this repo is a pnpm workspace: wrangler cannot guess
  // which package to deploy, and auto-detection fails with "run in the root of a workspace".
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "instavault",
  // The dashboard sets this too; declaring it here keeps the file the single
  // source of truth and stops the deploy warning about a dropped remote var.
  "vars": { "NODE_VERSION": "22" },
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./apps/web/dist",
    // Serve index.html for unknown paths. The app is a client-side SPA: /import,
    // /connections and /categories/:id are real routes with no file on disk.
    "not_found_handling": "single-page-application",
  },
}
