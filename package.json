{
  "name": "instavault",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @instavault/web dev",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm --filter @instavault/web build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "pnpm --filter @instavault/web build:e2e",
    "test:e2e": "tsc --noEmit -p tsconfig.e2e.json && node scripts/browser-check.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:filesize": "node scripts/check-file-size.mjs",
    "ingest:report": "tsx scripts/ingest-report.mjs",
    "drift": "tsx scripts/drift.mjs",
    "ci:status": "node scripts/ci-status.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:boundaries && pnpm check:filesize && pnpm check:styles && pnpm build && pnpm check:chunks",
    "check:styles": "node scripts/check-styles.mjs",
    "check:chunks": "node scripts/check-chunks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "playwright": "1.61.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "wrangler": "4.162.0"
  }
}
