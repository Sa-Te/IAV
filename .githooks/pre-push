#!/bin/sh
# The same command CI runs. AGENTS.md §10: a local green is not a green, and two
# check lists drift — so there is exactly one here.
#
# Installed by `pnpm install` through the root "prepare" script
# (`git config core.hooksPath .githooks`).

printf '[pre-push] running `pnpm verify` — identical to CI\n\n'

if ! pnpm verify; then
  printf '\n[pre-push] BLOCKED: `pnpm verify` failed. Push aborted.\n'
  printf '[pre-push] Fix the failing step above. Do not use --no-verify.\n\n'
  exit 1
fi

printf '\n[pre-push] verify passed.\n\n'
exit 0
